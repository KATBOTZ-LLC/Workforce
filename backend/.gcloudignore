# gcloud builds submit uses THIS file to decide what to upload — not
# .dockerignore, which only affects the docker build once the source is there.
# Without it the whole virtualenv is uploaded: 4133 files, 121 MiB, for an image
# that only needs requirements.txt and app/.
.gcloudignore
venv/
__pycache__/
*.pyc
.env
.env.*
firebase-emulator/
onboarding_lifecycle_test.sh
