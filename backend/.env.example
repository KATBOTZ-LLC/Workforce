# Copy to .env and fill in. Never commit .env — it is gitignored at the repo root.
#
# In Cloud Run these are NOT set from a file: DATABASE_URL, SESSION_SECRET and
# DOCUMENTS_BUCKET arrive from Secret Manager (see deploy/w1-09-secrets.sh) and
# the rest are plain environment variables set by cloudbuild.yaml.

# --- required ---------------------------------------------------------------

# From Google Auth Platform > Clients. Safe to expose to the frontend — it is
# a public identifier that ships inside the page.
#
# The client's audience must be Internal, which restricts sign-in to the
# Workspace org and avoids Google's app verification. The client SECRET is
# not used anywhere: the browser button flow needs only the id.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Signs our own session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this signs everyone out.
SESSION_SECRET=

# --- database ---------------------------------------------------------------

# Local development against a local PostgreSQL:
DATABASE_URL=postgresql+psycopg://wf_app:wf_app_local_dev@127.0.0.1:5432/wf_dev
#
# Local development against Cloud SQL through the Auth Proxy (deploy/w1-08-proxy.sh):
#   DATABASE_URL=postgresql+psycopg://wf_app:PASSWORD@127.0.0.1:5433/workforce
#
# In Cloud Run this comes from the wf-database-url secret and points at the
# instance's PRIVATE IP, reached over the VPC connector.
#
# Leave unset and the app falls back to the hardcoded org seed in org_data.py.

# --- optional ---------------------------------------------------------------

# Only @ this domain may sign in.
ALLOWED_DOMAIN=katbotz.com

# Where the Next.js frontend runs, for CORS. Must match the deployed web URL.
FRONTEND_ORIGIN=http://localhost:3000

# Cloud Storage bucket for uploaded documents. Unset locally until file upload
# is implemented.
DOCUMENTS_BUCKET=

# Legacy: the Firestore path predates PostgreSQL and is not used when
# DATABASE_URL is set. Leave blank.
FIRESTORE_PROJECT_ID=

# --- DEVELOPMENT ONLY -------------------------------------------------------
# Set WF_DEV_LOGIN=1 to expose POST /api/dev/login, which issues a session for
# any address already in PERSON_EMAIL. It exists only because real Google
# sign-in needs an OAuth client id. The route does not exist unless this is set,
# and cloudbuild.yaml never sets it.
#   WF_DEV_LOGIN=1 ./venv/bin/uvicorn app.main:app --reload
