# Copy to .env.local (gitignored). Restart `npm run dev` after changing this —
# Next.js only reads it at startup.
#
# IMPORTANT: NEXT_PUBLIC_* values are compiled INTO the browser bundle at build
# time. They are not read at runtime. Changing one in a deployed environment
# needs a rebuild, not a redeploy — which is why cloudbuild.yaml passes them as
# docker --build-arg rather than as Cloud Run environment variables.
#
# Being in the browser bundle also means neither of these can be a secret.
# Both are public identifiers.

# Same value as backend/.env's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Where the FastAPI backend is. In production this is the wf-api Cloud Run URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
