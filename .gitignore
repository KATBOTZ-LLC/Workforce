# The Python `lib/` rule above is unanchored and also matches frontend/app/lib
# (a legitimate Next.js source directory, not a Python venv lib) — un-ignore it.
!frontend/app/lib/
!frontend/app/lib/**

# Firebase CLI local cache/emulator data (backend/firebase-emulator/)
.firebase/
firestore-debug.log

# archived corrupt git internals (never commit)
